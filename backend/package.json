{
  "name": "slspot-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "npm run prisma:generate && tsx watch src/server.ts",
    "build": "npm run prisma:generate && tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "npm run prisma:generate && tsc -p tsconfig.json --noEmit",
    "test": "npm run prisma:generate && node --import tsx --test \"src/**/*.test.ts\"",
    "prisma:generate": "prisma --config prisma7.config.ts generate",
    "prisma:migrate": "prisma --config prisma7.config.ts migrate dev",
    "prisma:migrate:deploy": "prisma --config prisma7.config.ts migrate deploy",
    "prisma:migrate:status": "prisma --config prisma7.config.ts migrate status",
    "prisma:studio": "prisma --config prisma7.config.ts studio",
    "db:up": "docker compose -f docker-compose.yml up -d mysql",
    "db:down": "docker compose -f docker-compose.yml down",
    "db:logs": "docker compose -f docker-compose.yml logs -f mysql",
    "test:market": "node --import tsx --test src/market/*.test.ts"
  },
  "dependencies": {
    "@fastify/cors": "^11.3.0",
    "@fastify/websocket": "^11.3.1",
    "@prisma/adapter-mariadb": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "fastify": "^5.12.5",
    "mariadb": "^3.4.5",
    "redis": "^6.3.0",
    "@fastify/cookie": "^11.1.2"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/ws": "^8.18.2",
    "dotenv": "^18.0.5",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=24.0.0 <27",
    "npm": ">=10.0.0"
  },
  "overrides": {
    "deepmerge-ts": "8.0.2",
    "mysql2": "3.24.5",
    "@prisma/adapter-mariadb": {
      "mariadb": "3.4.7"
    }
  }
}
