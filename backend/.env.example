NODE_ENV=development
HOST=0.0.0.0
PORT=8080
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
TRUST_PROXY=false
REQUEST_TIMEOUT_MS=30000
SHUTDOWN_TIMEOUT_MS=10000
BODY_LIMIT_BYTES=1048576
DATABASE_URL=mysql://slspot:slspot@127.0.0.1:3306/slspot
DATABASE_CONNECTION_LIMIT=10
REDIS_URL=redis://127.0.0.1:6379
REDIS_REQUIRED=false
REDIS_CONNECT_TIMEOUT_MS=3000
REDIS_CHANNEL=slspot:realtime:v1
REDIS_KEY_PREFIX=slspot:
WEBSOCKET_MAX_PAYLOAD_BYTES=1048576
AUTH_SESSION_TTL_SECONDS=2592000
AUTH_SHORT_SESSION_TTL_SECONDS=43200
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_LOCK_SECONDS=900
AUTH_2FA_CHALLENGE_TTL_SECONDS=300
AUTH_2FA_MAX_ATTEMPTS=5
# 32-byte key as 64 hex characters; required explicitly in production.
AUTH_2FA_ENCRYPTION_KEY=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff
AUTH_VERIFICATION_TTL_SECONDS=86400
AUTH_PASSWORD_RESET_TTL_SECONDS=3600
AUTH_PASSWORD_MIN_LENGTH=12
AUTH_COOKIE_NAME=slspot_session
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_DOMAIN=
AUTH_EXPOSE_DEV_TOKENS=false

# Trading engine
TRADING_FEE_RATE=0
TRADING_INITIAL_BALANCE=12480.65
TRADING_MAX_OPEN_POSITIONS=20
TRADING_MAX_OPEN_EXPOSURE=100000
TRADING_MARKET_MAX_AGE_MS=10000
TRADING_SETTLEMENT_INTERVAL_MS=1000
# Expired real-money trades with no reliable price are voided and refunded after this long.
TRADING_VOID_AFTER_MS=60000
# Scheduled wallet-vs-ledger reconciliation; mismatches are logged at error level. 0 disables.
LEDGER_RECONCILE_INTERVAL_MS=900000

# Market data
# Crypto prices come from Binance only.
MARKET_DATA_PROVIDER=binance
MARKET_DATA_ENABLED=true
MARKET_DATA_BOOTSTRAP_ASSETS=true
MARKET_DATA_POLL_INTERVAL_MS=15000
MARKET_DATA_REQUEST_TIMEOUT_MS=10000
BINANCE_ENABLED=true
BINANCE_REST_URL=https://api.binance.com
BINANCE_WS_URL=wss://stream.binance.com:9443

# Transactional email. Leave disabled for local development.
EMAIL_PROVIDER=disabled
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_API_URL=https://api.resend.com
EMAIL_REQUEST_TIMEOUT_MS=10000
# Public web origin used for verification/reset/notification links.
APP_BASE_URL=http://localhost:5173

# Payments (see docs/PAYMENTS.md). The sandbox fakes money movement and is refused in production.
PAYMENTS_SANDBOX=true
# PAYMENTS_SANDBOX_WEBHOOK_SECRET=
# Local testing only: skip KYC/2FA/turnover/cooling-off checks on withdrawals.
PAYMENTS_RELAX_WITHDRAWAL_CHECKS=false
PAYMENTS_TIER1_DEPOSIT_LIMIT=0
PAYMENTS_WITHDRAWAL_REVIEW_THRESHOLD=1000
PAYMENTS_WITHDRAWAL_TURNOVER_MULTIPLE=1
PAYMENTS_WITHDRAWAL_COOLING_HOURS=24
PAYMENTS_DEPOSIT_EXPIRY_MINUTES=60
# Comma-separated ISO-2 codes. Empty = open to every country for now.
PAYMENTS_BLOCKED_COUNTRIES=
