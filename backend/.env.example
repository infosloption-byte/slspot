NODE_ENV=development
HOST=0.0.0.0
PORT=8080
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
TRUST_PROXY=false
REQUEST_TIMEOUT_MS=30000
SHUTDOWN_TIMEOUT_MS=10000
BODY_LIMIT_BYTES=1048576
DATABASE_URL=mysql://slspot:slspot@127.0.0.1:3306/slspot
DATABASE_CONNECTION_LIMIT=10
REDIS_URL=redis://127.0.0.1:6379
REDIS_REQUIRED=false
REDIS_CONNECT_TIMEOUT_MS=3000
REDIS_CHANNEL=slspot:realtime:v1
REDIS_KEY_PREFIX=slspot:
WEBSOCKET_MAX_PAYLOAD_BYTES=1048576
AUTH_SESSION_TTL_SECONDS=2592000
AUTH_SHORT_SESSION_TTL_SECONDS=43200
AUTH_LOGIN_MAX_ATTEMPTS=5
AUTH_LOGIN_LOCK_SECONDS=900
AUTH_2FA_CHALLENGE_TTL_SECONDS=300
AUTH_2FA_MAX_ATTEMPTS=5
# 32-byte key as 64 hex characters; required explicitly in production.
AUTH_2FA_ENCRYPTION_KEY=00112233445566778899aabbccddeeff00112233445566778899aabbccddeeff
AUTH_VERIFICATION_TTL_SECONDS=86400
AUTH_PASSWORD_RESET_TTL_SECONDS=3600
AUTH_PASSWORD_MIN_LENGTH=12
AUTH_COOKIE_NAME=slspot_session
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_DOMAIN=
AUTH_EXPOSE_DEV_TOKENS=false

# Trading engine
TRADING_FEE_RATE=0
TRADING_INITIAL_BALANCE=12480.65
TRADING_MAX_OPEN_POSITIONS=20
TRADING_MAX_OPEN_EXPOSURE=100000
TRADING_MARKET_MAX_AGE_MS=120000
TRADING_SETTLEMENT_INTERVAL_MS=1000

# Market data
# Live prices need a Twelve Data key (MARKET_DATA_API_KEY). Without one, or while the feed is
# failing, non-production environments fall back to simulated prices so the UI is never empty.
# MARKET_DATA_API_KEY=
# MARKET_DATA_SIMULATE=true   # forced off in production
# Crypto (BTC, ETH, SOL, XRP) streams tick-by-tick from Binance's public feed; no key needed.
# Forex, stocks, gold and NAS100 still use Twelve Data (MARKET_DATA_API_KEY).
# BINANCE_ENABLED=true
# BINANCE_REST_URL=https://api.binance.com
# BINANCE_WS_URL=wss://stream.binance.com:9443
# Other public Binance hosts (data-api.binance.vision, api1/api2, data-stream.binance.vision) are tried automatically
# when the primary one is blocked or slow on your network.
