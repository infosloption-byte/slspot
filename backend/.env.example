NODE_ENV=development
HOST=0.0.0.0
PORT=8080
CORS_ORIGIN=http://localhost:5173
LOG_LEVEL=info
TRUST_PROXY=false
REQUEST_TIMEOUT_MS=30000
SHUTDOWN_TIMEOUT_MS=10000
BODY_LIMIT_BYTES=1048576
DATABASE_URL=mysql://slspot:slspot@127.0.0.1:3307/slspot
DATABASE_CONNECTION_LIMIT=10
REDIS_URL=redis://127.0.0.1:6379
REDIS_REQUIRED=false
REDIS_CONNECT_TIMEOUT_MS=3000
REDIS_CHANNEL=slspot:realtime:v1
REDIS_KEY_PREFIX=slspot:
WEBSOCKET_MAX_PAYLOAD_BYTES=1048576
AUTH_SESSION_TTL_SECONDS=2592000
AUTH_VERIFICATION_TTL_SECONDS=86400
AUTH_PASSWORD_RESET_TTL_SECONDS=3600
AUTH_PASSWORD_MIN_LENGTH=12
AUTH_COOKIE_NAME=slspot_session
AUTH_COOKIE_SAMESITE=lax
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_DOMAIN=
AUTH_EXPOSE_DEV_TOKENS=false
