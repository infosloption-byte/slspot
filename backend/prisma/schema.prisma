generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
}

enum AdminRole {
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  DISABLED
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum AccountMode {
  DEMO
  REAL
}

enum AssetType {
  CRYPTO
  FOREX
  STOCK
  COMMODITY
  INDEX
  OTHER
}

enum MarketStatus {
  OPEN
  CLOSED
  HALTED
  MAINTENANCE
}

enum OrderType {
  MARKET
  LIMIT
}

enum OrderSide {
  BUY
  SELL
}

enum OrderStatus {
  PENDING
  ACCEPTED
  REJECTED
  CANCELLED
  FAILED
}

enum PositionStatus {
  OPEN
  CLOSED
}

enum TradeStatus {
  OPEN
  WON
  LOST
  DRAW
  CANCELLED
  EXPIRED
}

enum SettlementStatus {
  PENDING
  COMPLETED
  FAILED
}

enum WalletStatus {
  ACTIVE
  SUSPENDED
  CLOSED
}

enum WalletTransactionType {
  DEPOSIT
  WITHDRAWAL
  TRADE_HOLD
  TRADE_RELEASE
  SETTLEMENT
  FEE
  ADJUSTMENT
}

enum WalletTransactionStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REJECTED
}

enum LedgerDirection {
  DEBIT
  CREDIT
}

enum LedgerAccountType {
  ASSET
  LIABILITY
  EQUITY
  REVENUE
  EXPENSE
}

enum DepositStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REJECTED
}

enum WithdrawalStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  REJECTED
}

enum KycStatus {
  NOT_STARTED
  PENDING
  IN_REVIEW
  APPROVED
  REJECTED
}

enum NotificationType {
  TRADE_RESULT
  DEPOSIT
  WITHDRAWAL
  SECURITY
  VERIFICATION
  SYSTEM
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
  TWO_FACTOR_CHALLENGE
}

enum SupportTicketStatus {
  OPEN
  IN_PROGRESS
  WAITING_USER
  RESOLVED
  CLOSED
}

enum SupportCategory {
  ACCOUNT
  TRADING
  WALLET
  TECHNICAL
  OTHER
}

enum AnnouncementStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

model User {
  id            String       @id @default(uuid()) @db.Char(36)
  email         String       @unique @db.VarChar(191)
  passwordHash  String       @db.VarChar(255)
  status        UserStatus   @default(PENDING_VERIFICATION)
  countryCode   String?      @db.Char(2)
  displayName   String?      @db.VarChar(120)
  timezone      String?      @db.VarChar(64)
  locale        String?      @db.VarChar(35)
  createdAt     DateTime     @default(now()) @db.DateTime(3)
  updatedAt     DateTime     @updatedAt @db.DateTime(3)
  lastLoginAt       DateTime?    @db.DateTime(3)
  emailVerifiedAt   DateTime?    @db.DateTime(3)
  twoFactorEnabled  Boolean      @default(false)
  twoFactorSecretEnc String?     @db.VarChar(512)
  twoFactorPendingSecretEnc String? @db.VarChar(512)
  loginFailedCount  Int          @default(0)
  loginLockedUntil  DateTime?    @db.DateTime(3)
  termsAcceptedAt   DateTime?    @db.DateTime(3)
  termsVersion      String?      @db.VarChar(32)

  sessions      Session[]
  devices       Device[]
  authTokens    AuthToken[]
  accounts      Account[]
  orders        Order[]
  positions     Position[]
  trades        Trade[]
  kycCases      KycCase[]
  notifications Notification[]
  recoveryCodes RecoveryCode[]
  auditLogs     AuditLog[]   @relation("AuditActor")
  preferences   UserPreference?
  supportTickets SupportTicket[]
  supportMessages SupportMessage[]
  announcements SystemAnnouncement[] @relation("AnnouncementAuthor")
  adminAccess   AdminAccess?
}

model AdminAccess {
  id        String    @id @default(uuid()) @db.Char(36)
  userId    String    @unique @db.Char(36)
  role      AdminRole @default(ADMIN)
  createdAt DateTime  @default(now()) @db.DateTime(3)
  updatedAt DateTime  @updatedAt @db.DateTime(3)

  user      User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([role])
}

model Session {
  id         String    @id @default(uuid()) @db.Char(36)
  userId     String    @db.Char(36)
  deviceId   String?   @db.Char(36)
  tokenHash  String    @unique @db.VarChar(191)
  expiresAt  DateTime  @db.DateTime(3)
  revokedAt  DateTime? @db.DateTime(3)
  ipAddress  String?   @db.VarChar(64)
  userAgent  String?   @db.VarChar(512)
  createdAt  DateTime  @default(now()) @db.DateTime(3)
  updatedAt  DateTime  @updatedAt @db.DateTime(3)

  user       User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  device     Device?   @relation(fields: [deviceId], references: [id], onDelete: Restrict)

  @@index([userId, expiresAt])
  @@index([deviceId])
  @@index([userId, revokedAt])
}

model AuthToken {
  id         String        @id @default(uuid()) @db.Char(36)
  userId     String        @db.Char(36)
  type       AuthTokenType
  tokenHash  String        @unique @db.VarChar(191)
  expiresAt  DateTime      @db.DateTime(3)
  consumedAt DateTime?     @db.DateTime(3)
  createdAt  DateTime      @default(now()) @db.DateTime(3)
  attempts   Int           @default(0)

  user       User          @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId, type, expiresAt])
  @@index([userId, type, consumedAt])
}

model Device {
  id              String    @id @default(uuid()) @db.Char(36)
  userId          String    @db.Char(36)
  deviceName      String?   @db.VarChar(120)
  fingerprintHash String?   @db.VarChar(255)
  userAgent       String?   @db.VarChar(512)
  lastSeenAt      DateTime  @default(now()) @db.DateTime(3)
  revokedAt       DateTime? @db.DateTime(3)
  createdAt       DateTime  @default(now()) @db.DateTime(3)
  updatedAt       DateTime  @updatedAt @db.DateTime(3)

  user            User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  sessions        Session[]

  @@index([userId, revokedAt])
  @@index([userId, lastSeenAt])
}

model RecoveryCode {
  id         String    @id @default(uuid()) @db.Char(36)
  userId     String    @db.Char(36)
  codeHash   String    @unique @db.VarChar(128)
  usedAt     DateTime? @db.DateTime(3)
  createdAt  DateTime  @default(now()) @db.DateTime(3)

  user       User      @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId, usedAt])
}

model Account {
  id            String        @id @default(uuid()) @db.Char(36)
  userId        String        @db.Char(36)
  name          String        @db.VarChar(120)
  currency      String        @db.Char(3)
  mode          AccountMode   @default(DEMO)
  status        AccountStatus @default(ACTIVE)
  createdAt     DateTime      @default(now()) @db.DateTime(3)
  updatedAt     DateTime      @updatedAt @db.DateTime(3)

  user          User          @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  orders        Order[]
  positions     Position[]
  wallets       Wallet[]
  ledgerAccounts LedgerAccount[]

  @@unique([userId, currency, mode])
  @@index([userId, status])
}

model Asset {
  id            String     @id @default(uuid()) @db.Char(36)
  symbol        String     @unique @db.VarChar(32)
  name          String     @db.VarChar(120)
  type          AssetType
  baseCurrency  String?    @db.VarChar(32)
  quoteCurrency String?    @db.Char(3)
  priceScale    Int        @default(8)
  quantityScale Int        @default(8)
  isActive      Boolean    @default(true)
  sortOrder     Int        @default(0)
  createdAt     DateTime   @default(now()) @db.DateTime(3)
  updatedAt     DateTime   @updatedAt @db.DateTime(3)

  markets       Market[]
  orders        Order[]
  positions     Position[]

  @@index([type, isActive, sortOrder])
}

model Market {
  id             String       @id @default(uuid()) @db.Char(36)
  assetId        String       @db.Char(36)
  provider       String       @db.VarChar(64)
  externalSymbol String       @db.VarChar(127)
  status         MarketStatus @default(CLOSED)
  lastPrice      Decimal?     @db.Decimal(30, 12)
  lastPriceAt    DateTime?    @db.DateTime(3)
  lastChangePct  Decimal?     @db.Decimal(18, 8)
  lastVolume         Decimal?     @db.Decimal(30, 8)
  lastPriceProvider  String?      @db.VarChar(64)
  createdAt      DateTime     @default(now()) @db.DateTime(3)
  updatedAt      DateTime     @updatedAt @db.DateTime(3)

  asset          Asset        @relation(fields: [assetId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@unique([provider, externalSymbol])
  @@index([assetId, status])
}

model Order {
  id              String       @id @default(uuid()) @db.Char(36)
  clientRequestId String       @unique @db.VarChar(128)
  userId          String       @db.Char(36)
  accountId       String       @db.Char(36)
  assetId         String       @db.Char(36)
  type            OrderType
  side            OrderSide
  status          OrderStatus  @default(PENDING)
  amount          Decimal      @db.Decimal(30, 8)
  requestedPrice  Decimal?     @db.Decimal(30, 12)
  executedPrice   Decimal?     @db.Decimal(30, 12)
  durationSeconds Int?
  expiresAt       DateTime?    @db.DateTime(3)
  fee             Decimal      @default(0) @db.Decimal(30, 8)
  payoutRate      Decimal      @default(0.8) @db.Decimal(8, 6)
  rejectionReason String?      @db.VarChar(255)
  createdAt       DateTime     @default(now()) @db.DateTime(3)
  updatedAt       DateTime     @updatedAt @db.DateTime(3)
  acceptedAt      DateTime?    @db.DateTime(3)

  user            User         @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  account         Account      @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  asset           Asset        @relation(fields: [assetId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  position        Position?

  @@index([userId, createdAt])
  @@index([accountId, status, createdAt])
  @@index([assetId, status, createdAt])
}

model Position {
  id          String         @id @default(uuid()) @db.Char(36)
  orderId     String         @unique @db.Char(36)
  userId      String         @db.Char(36)
  accountId   String         @db.Char(36)
  assetId     String         @db.Char(36)
  side        OrderSide
  status      PositionStatus @default(OPEN)
  amount      Decimal        @db.Decimal(30, 8)
  entryPrice  Decimal        @db.Decimal(30, 12)
  exitPrice   Decimal?       @db.Decimal(30, 12)
  openedAt    DateTime       @default(now()) @db.DateTime(3)
  closedAt    DateTime?      @db.DateTime(3)
  createdAt   DateTime       @default(now()) @db.DateTime(3)
  updatedAt   DateTime       @updatedAt @db.DateTime(3)

  order       Order          @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user        User           @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  account     Account        @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  asset       Asset          @relation(fields: [assetId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  trade       Trade?

  @@index([userId, status, openedAt])
  @@index([accountId, status, openedAt])
  @@index([assetId, status, openedAt])
}

model Trade {
  id         String      @id @default(uuid()) @db.Char(36)
  positionId String      @unique @db.Char(36)
  userId     String      @db.Char(36)
  status     TradeStatus @default(OPEN)
  grossPnl   Decimal?    @db.Decimal(30, 8)
  fee            Decimal      @default(0) @db.Decimal(30, 8)
  entryProvider  String?       @db.VarChar(64)
  entryTimestamp DateTime?     @db.DateTime(3)
  netPnl     Decimal?    @db.Decimal(30, 8)
  openedAt   DateTime    @default(now()) @db.DateTime(3)
  closedAt   DateTime?   @db.DateTime(3)
  createdAt  DateTime    @default(now()) @db.DateTime(3)
  updatedAt  DateTime    @updatedAt @db.DateTime(3)

  position   Position    @relation(fields: [positionId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  user       User        @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  settlement Settlement?

  @@index([userId, status, openedAt])
  @@index([status, openedAt])
}

model Settlement {
  id              String           @id @default(uuid()) @db.Char(36)
  tradeId         String           @unique @db.Char(36)
  status          SettlementStatus @default(PENDING)
  settlementPrice     Decimal?         @db.Decimal(30, 12)
  entryPrice           Decimal?         @db.Decimal(30, 12)
  entryProvider        String?          @db.VarChar(64)
  entryTimestamp       DateTime?        @db.DateTime(3)
  settlementProvider   String?          @db.VarChar(64)
  settlementTimestamp  DateTime?        @db.DateTime(3)
  grossPayout          Decimal?         @db.Decimal(30, 8)
  fees                 Decimal          @default(0) @db.Decimal(30, 8)
  netPnl               Decimal?         @db.Decimal(30, 8)
  referenceId     String?          @db.VarChar(127)
  settledAt       DateTime?        @db.DateTime(3)
  createdAt       DateTime         @default(now()) @db.DateTime(3)
  updatedAt       DateTime         @updatedAt @db.DateTime(3)

  trade           Trade            @relation(fields: [tradeId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([status, settledAt])
  @@index([referenceId])
}

model Wallet {
  id               String        @id @default(uuid()) @db.Char(36)
  accountId        String        @unique @db.Char(36)
  currency         String        @db.Char(3)
  status           WalletStatus  @default(ACTIVE)
  availableBalance Decimal       @default(0) @db.Decimal(30, 8)
  heldBalance      Decimal       @default(0) @db.Decimal(30, 8)
  createdAt        DateTime      @default(now()) @db.DateTime(3)
  updatedAt        DateTime      @updatedAt @db.DateTime(3)

  account          Account       @relation(fields: [accountId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  transactions     WalletTransaction[]
  deposits         Deposit[]
  withdrawals      Withdrawal[]

  @@index([status])
}

model WalletTransaction {
  id                   String                  @id @default(uuid()) @db.Char(36)
  walletId             String                  @db.Char(36)
  type                 WalletTransactionType
  status               WalletTransactionStatus @default(PENDING)
  amount               Decimal                 @db.Decimal(30, 8)
  currency             String                  @db.Char(3)
  idempotencyKey       String                  @unique @db.VarChar(128)
  referenceType        String?                 @db.VarChar(64)
  referenceId          String?                 @db.VarChar(127)
  description          String?                 @db.VarChar(255)
  availableBalanceAfter Decimal?              @db.Decimal(30, 8)
  heldBalanceAfter      Decimal?              @db.Decimal(30, 8)
  createdAt             DateTime                @default(now()) @db.DateTime(3)
  updatedAt             DateTime                @updatedAt @db.DateTime(3)

  wallet              Wallet             @relation(fields: [walletId], references: [id], onDelete: Restrict)
  ledgerTransaction   LedgerTransaction?
  deposit             Deposit?
  withdrawal          Withdrawal?

  @@index([walletId, createdAt])
  @@index([referenceType, referenceId])
}

model LedgerAccount {
  id          String            @id @default(uuid()) @db.Char(36)
  code        String            @unique @db.VarChar(96)
  name        String            @db.VarChar(160)
  type        LedgerAccountType
  currency    String            @db.Char(3)
  accountId   String?           @db.Char(36)
  active      Boolean           @default(true)
  createdAt   DateTime          @default(now()) @db.DateTime(3)
  updatedAt   DateTime          @updatedAt @db.DateTime(3)

  account     Account?          @relation(fields: [accountId], references: [id], onDelete: Restrict)
  entries     LedgerEntry[]
  snapshots   LedgerBalanceSnapshot[]

  @@index([accountId, active])
  @@index([type, currency, active])
}

model LedgerTransaction {
  id                  String           @id @default(uuid()) @db.Char(36)
  walletTransactionId String?          @unique @db.Char(36)
  currency            String           @db.Char(3)
  referenceType       String?          @db.VarChar(64)
  referenceId         String?          @db.VarChar(128)
  description         String?          @db.VarChar(255)
  metadata            Json?
  createdAt           DateTime         @default(now()) @db.DateTime(3)

  walletTransaction   WalletTransaction?   @relation(fields: [walletTransactionId], references: [id], onDelete: Restrict)
  entries             LedgerEntry[]
  snapshots           LedgerBalanceSnapshot[]

  @@index([referenceType, referenceId, createdAt])
}

model LedgerEntry {
  id                  String           @id @default(uuid()) @db.Char(36)
  ledgerTransactionId String           @db.Char(36)
  ledgerAccountId     String           @db.Char(36)
  direction           LedgerDirection
  amount              Decimal          @db.Decimal(30, 8)
  currency            String           @db.Char(3)
  referenceType       String?          @db.VarChar(64)
  referenceId         String?          @db.VarChar(128)
  createdAt           DateTime         @default(now()) @db.DateTime(3)

  ledgerTransaction   LedgerTransaction @relation(fields: [ledgerTransactionId], references: [id], onDelete: Restrict)
  ledgerAccount       LedgerAccount     @relation(fields: [ledgerAccountId], references: [id], onDelete: Restrict)

  @@index([ledgerTransactionId])
  @@index([ledgerAccountId, createdAt])
  @@index([referenceType, referenceId])
}

model LedgerBalanceSnapshot {
  id                   String             @id @default(uuid()) @db.Char(36)
  ledgerAccountId      String             @db.Char(36)
  ledgerTransactionId  String             @db.Char(36)
  currency             String             @db.Char(3)
  balance              Decimal            @db.Decimal(30, 8)
  createdAt            DateTime           @default(now()) @db.DateTime(3)

  ledgerAccount      LedgerAccount     @relation(fields: [ledgerAccountId], references: [id], onDelete: Restrict)
  ledgerTransaction  LedgerTransaction @relation(fields: [ledgerTransactionId], references: [id], onDelete: Restrict)

  @@index([ledgerAccountId, createdAt])
  @@index([ledgerTransactionId])
}

model Deposit {
  id                String        @id @default(uuid()) @db.Char(36)
  walletId          String        @db.Char(36)
  walletTransactionId String?      @unique @db.Char(36)
  provider          String        @db.VarChar(64)
  providerReference String?       @unique @db.VarChar(128)
  amount            Decimal       @db.Decimal(30, 8)
  currency          String        @db.Char(3)
  status            DepositStatus @default(PENDING)
  failureReason     String?       @db.VarChar(255)
  requestedAt       DateTime      @default(now()) @db.DateTime(3)
  completedAt       DateTime?     @db.DateTime(3)
  createdAt         DateTime      @default(now()) @db.DateTime(3)
  updatedAt         DateTime      @updatedAt @db.DateTime(3)

  wallet            Wallet              @relation(fields: [walletId], references: [id], onDelete: Restrict)
  walletTransaction WalletTransaction?  @relation(fields: [walletTransactionId], references: [id], onDelete: Restrict)

  @@index([walletId, createdAt])
  @@index([provider, status, createdAt])
}

model Withdrawal {
  id                String           @id @default(uuid()) @db.Char(36)
  walletId          String           @db.Char(36)
  walletTransactionId String?         @unique @db.Char(36)
  provider          String           @db.VarChar(64)
  providerReference String?          @unique @db.VarChar(128)
  destination       String?           @db.VarChar(255)
  amount            Decimal          @db.Decimal(30, 8)
  currency          String           @db.Char(3)
  status            WithdrawalStatus @default(PENDING)
  failureReason     String?           @db.VarChar(255)
  requestedAt       DateTime         @default(now()) @db.DateTime(3)
  completedAt       DateTime?        @db.DateTime(3)
  createdAt         DateTime         @default(now()) @db.DateTime(3)
  updatedAt         DateTime         @updatedAt @db.DateTime(3)

  wallet            Wallet              @relation(fields: [walletId], references: [id], onDelete: Restrict)
  walletTransaction WalletTransaction?  @relation(fields: [walletTransactionId], references: [id], onDelete: Restrict)

  @@index([walletId, createdAt])
  @@index([provider, status, createdAt])
}

model KycCase {
  id             String     @id @default(uuid()) @db.Char(36)
  userId         String     @db.Char(36)
  provider       String?    @db.VarChar(64)
  providerCaseId String?    @unique @db.VarChar(128)
  status         KycStatus  @default(NOT_STARTED)
  submittedAt    DateTime?  @db.DateTime(3)
  resolvedAt     DateTime?  @db.DateTime(3)
  createdAt      DateTime   @default(now()) @db.DateTime(3)
  updatedAt      DateTime   @updatedAt @db.DateTime(3)

  user           User       @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([userId, status])
  @@index([provider, status])
}

model UserPreference {
  userId                   String   @id @db.Char(36)
  compactTradingLayout    Boolean  @default(false)
  priceMovementAlerts     Boolean  @default(false)
  soundEnabled             Boolean  @default(false)
  emailTradeResults       Boolean  @default(true)
  emailWalletUpdates      Boolean  @default(true)
  emailSecurityAlerts     Boolean  @default(true)
  emailAnnouncements      Boolean  @default(true)
  emailSupportUpdates      Boolean  @default(true)
  createdAt               DateTime @default(now()) @db.DateTime(3)
  updatedAt               DateTime @updatedAt @db.DateTime(3)

  user                     User     @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
}

model SupportTicket {
  id           String             @id @default(uuid()) @db.Char(36)
  userId       String             @db.Char(36)
  subject      String             @db.VarChar(160)
  category     SupportCategory
  status       SupportTicketStatus @default(OPEN)
  createdAt    DateTime           @default(now()) @db.DateTime(3)
  updatedAt    DateTime           @updatedAt @db.DateTime(3)
  resolvedAt   DateTime?

  user         User               @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  messages     SupportMessage[]

  @@index([userId, status, updatedAt])
}

model SupportMessage {
  id           String   @id @default(uuid()) @db.Char(36)
  ticketId     String   @db.Char(36)
  authorUserId String   @db.Char(36)
  body         String   @db.Text
  createdAt    DateTime @default(now()) @db.DateTime(3)

  ticket       SupportTicket @relation(fields: [ticketId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  author       User        @relation(fields: [authorUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([ticketId, createdAt])
  @@index([authorUserId, createdAt])
}

model SystemAnnouncement {
  id            String             @id @default(uuid()) @db.Char(36)
  title         String             @db.VarChar(160)
  body          String             @db.Text
  status        AnnouncementStatus @default(DRAFT)
  createdByUserId String            @db.Char(36)
  publishedAt   DateTime?
  createdAt     DateTime            @default(now()) @db.DateTime(3)
  updatedAt     DateTime            @updatedAt @db.DateTime(3)

  createdBy      User               @relation("AnnouncementAuthor", fields: [createdByUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  notifications Notification[]

  @@index([status, publishedAt])
}

model Notification {
  id             String              @id @default(uuid()) @db.Char(36)
  userId         String              @db.Char(36)
  type           NotificationType
  title          String              @db.VarChar(160)
  body           String              @db.Text
  announcementId String?        @db.Char(36)
  readAt         DateTime?           @db.DateTime(3)
  createdAt      DateTime            @default(now()) @db.DateTime(3)

  user           User                @relation(fields: [userId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  announcement   SystemAnnouncement? @relation(fields: [announcementId], references: [id], onDelete: SetNull, onUpdate: Cascade)

  @@index([userId, readAt, createdAt])
  @@index([announcementId])
}

model AuditLog {
  id          String    @id @default(uuid()) @db.Char(36)
  actorUserId String?   @db.Char(36)
  action      String    @db.VarChar(100)
  entityType  String    @db.VarChar(64)
  entityId    String?   @db.VarChar(127)
  metadata    Json?
  ipAddress   String?   @db.VarChar(64)
  userAgent   String?   @db.VarChar(512)
  createdAt   DateTime  @default(now()) @db.DateTime(3)

  actorUser   User?     @relation("AuditActor", fields: [actorUserId], references: [id], onDelete: Restrict, onUpdate: Cascade)

  @@index([actorUserId, createdAt])
  @@index([entityType, entityId, createdAt])
  @@index([action, createdAt])
}

model RealMoneyGate {
  id                String   @id @default("GLOBAL") @db.VarChar(16)
  tradingEnabled    Boolean  @default(false)
  depositsEnabled   Boolean  @default(false)
  withdrawalsEnabled Boolean  @default(false)
  updatedAt         DateTime @updatedAt @db.DateTime(3)
}
