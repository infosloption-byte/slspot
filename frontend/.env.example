# Browser-visible configuration only. Never put secrets here.
VITE_API_BASE_URL=/api/v1
# Development uses Vite's same-origin /ws proxy automatically.
# Set VITE_WS_URL only for non-dev deployments that use a separate websocket origin.

# Public address of the site, used for search-engine tags, robots.txt and sitemap.xml when building for production.
# Leave empty and those tags are simply left out.
# VITE_SITE_URL=https://www.example.com
